{
  "name": "nestjs-hyper-express",
  "version": "0.1.0",
  "description": "Hyper-Express adapter for NestJS",
  "author": "Felipe Lohan Farias dos Santos",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "hyper-express": "^6.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/testing": "^11.2.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.56.0",
    "hyper-express": "^6.16.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "nestjs",
    "hyper-express",
    "adapter",
    "http",
    "fast",
    "uwebsockets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelipeLohan/nestjs-hyper-express.git"
  },
  "bugs": {
    "url": "https://github.com/FelipeLohan/nestjs-hyper-express/issues"
  }
}
